+endif()
+configure_file("${GAMECONTROLLERDB_FILE}" "${CMAKE_BINARY_DIR}/gamecontrollerdb.txt" COPYONLY)
 
 if("${CMAKE_SYSTEM_NAME}" STREQUAL "Darwin")
